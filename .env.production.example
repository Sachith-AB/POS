# ─── Shop 1 Environment (pos.yaga.lk) ───────────────────────────────────────
# Copy this file to .env and fill in values on the VPS
# NEVER commit this file to git!

# Domain
DOMAIN=pos.yaga.lk

# Database
DB_USER=pos_user
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
DB_NAME=pos_shop1

# JWT - generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_THIS_STRONG_SECRET

# SMS (set to stub if not using)
SMS_PROVIDER=stub
SMS_API_KEY=
SMS_SENDER_ID=

# Notifications
OWNER_PHONE=+94771234567

# Cron schedules
DAILY_SUMMARY_CRON=0 21 * * *
BACKUP_CRON=0 2 * * *
BACKUP_RETENTION_DAYS=7
