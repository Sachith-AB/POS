generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  EMPLOYEE
  TECHNICIAN
}

enum SaleStatus {
  PARKED
  COMPLETED
  VOID
}

enum SerializedItemStatus {
  IN_STOCK
  SOLD
}

enum StockMovementType {
  RECEIVE
  SALE
  ADJUSTMENT
  RETURN
}

enum InstallmentStatus {
  ACTIVE
  COMPLETE
  OVERDUE
}

enum RepairStatus {
  RECEIVED
  DIAGNOSING
  AWAITING_PARTS
  REPAIRED
  DELIVERED
  CANCELLED
}

enum OutboxType {
  BACKUP
  SMS
  DASHBOARD_SYNC
}

enum OutboxStatus {
  PENDING
  SENT
  FAILED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  EZ_CASH_ONLINE
}

enum InstallmentPaymentMethod {
  CASH
  BANK_TRANSFER
}

enum PriceType {
  RETAIL
  WHOLESALE
  BUSINESS
}

enum InterestMethod {
  PERCENTAGE
  FIXED_AMOUNT
}

enum LateFeeMethod {
  PERCENTAGE
  FIXED_AMOUNT
}

enum CommissionMethod {
  PERCENTAGE
  FIXED_AMOUNT
}

enum SupplierTransactionType {
  PURCHASE
  PAYMENT
  RETURN_CREDIT
}

enum SupplierReturnReason {
  DEFECTIVE
  DAMAGED
  WRONG_ITEM
}

enum TradeInStatus {
  PENDING
  ADJUSTED
  IN_STOCK
  SOLD
}

enum DefaultActionType {
  WARNING
  BLOCK
  SUSPEND
  CUSTOM
}

enum OutsourcedRepairStatus {
  SENT
  IN_PROGRESS
  RETURNED
  CANCELLED
}

enum ThemeModeSetting {
  light
  dark
  system
}

enum BarcodeScannerMode {
  USB_HID
  CAMERA
}

/// Singleton row: shop branding + hardware config + configurable defaults.
model ShopSettings {
  id                   String            @id @default(cuid())
  companyName          String            @default("My Shop")
  logoUrl              String?
  primaryColor         String            @default("#1E40AF")
  themeMode            ThemeModeSetting  @default(system)
  discountLimitPercent Decimal           @default(20) @db.Decimal(5, 2)
  lowStockDefaultDays  Int               @default(90)
  receiptPrinterType   String?
  receiptPrinterName   String?
  cashDrawerEnabled    Boolean           @default(false)
  barcodeScannerMode   BarcodeScannerMode @default(USB_HID)
  receiptWidth         String            @default("80mm")

  // Q1-Q28 Configurable Defaults
  defaultDiscountPercent   Decimal          @default(10) @db.Decimal(5, 2)
  defaultDownPaymentPercent Decimal         @default(35) @db.Decimal(5, 2)
  defaultInterestMethod    InterestMethod   @default(PERCENTAGE)
  defaultInterestValue     Decimal          @default(0) @db.Decimal(12, 2)
  defaultLateFeeMethod     LateFeeMethod    @default(FIXED_AMOUNT)
  defaultLateFeeValue      Decimal          @default(0) @db.Decimal(12, 2)
  defaultCommissionMethod  CommissionMethod @default(PERCENTAGE)
  defaultCommissionValue   Decimal          @default(0) @db.Decimal(12, 2)
  defaultTechnicianId      String?
  uncollectedRepairDays    Int              @default(30)
  firstDaysWarrantyDays    Int              @default(3)

  // text.lk SMS Config
  textlkApiToken           String?
  textlkSenderId           String?

  updatedAt            DateTime          @updatedAt

  @@map("shop_settings")
}

model Employee {
  id        String   @id @default(cuid())
  name      String
  pinHash   String
  role      Role
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  sales            Sale[]
  stockMovements   StockMovement[]
  auditLogs        AuditLog[]
  assignedRepairs  RepairTicket[] @relation("TechnicianRepairs")

  @@map("employees")
}

model Customer {
  id          String   @id @default(cuid())
  phone       String   @unique
  name        String?
  nic         String?  @unique
  address     String?
  notes       String?
  isBlocked   Boolean  @default(false)
  isSuspended Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  sales         Sale[]
  repairTickets RepairTicket[]
  tradeIns      TradeIn[]
  categories    CustomerCategoryAssignment[]

  @@index([phone])
  @@index([nic])
  @@map("customers")
}

model CustomerCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  emoji       String?
  color       String?
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  assignments CustomerCategoryAssignment[]

  @@map("customer_categories")
}

model CustomerCategoryAssignment {
  id          String   @id @default(cuid())
  customerId  String
  categoryId  String
  assignedAt  DateTime @default(now())

  customer Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  category CustomerCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([customerId, categoryId])
  @@map("customer_category_assignments")
}


model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())

  products    Product[]

  @@map("categories")
}

model Product {
  id                String   @id @default(cuid())
  sku               String   @unique
  barcode           String?  @unique
  name              String
  costPrice         Decimal  @db.Decimal(12, 2)
  sellPrice         Decimal  @db.Decimal(12, 2) // Retail Price
  wholesalePrice    Decimal? @db.Decimal(12, 2) // Wholesale Price
  businessPrice     Decimal? @db.Decimal(12, 2) // Business Price
  quantity          Int      @default(0)
  lowStockThreshold Int      @default(3)
  category          String
  categoryId        String?
  warrantyPeriodId  String?
  warrantyDurationDays Int?
  isSerialized      Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  categoryRel     Category?        @relation(fields: [categoryId], references: [id])
  warrantyPeriod  WarrantyPeriod?  @relation("ProductWarrantyPeriod", fields: [warrantyPeriodId], references: [id])
  serializedItems SerializedItem[]
  stockMovements  StockMovement[]
  saleItems       SaleItem[]
  supplierReturns SupplierReturn[]

  @@index([barcode])
  @@index([category])
  @@map("products")
}


model SerializedItem {
  id               String                @id @default(cuid())
  productId        String
  imei             String                @unique
  status           SerializedItemStatus  @default(IN_STOCK)
  soldInSaleItemId String?               @unique
  createdAt        DateTime              @default(now())

  product        Product         @relation(fields: [productId], references: [id])
  soldInSaleItem SaleItem?       @relation(fields: [soldInSaleItemId], references: [id])
  supplierReturns SupplierReturn[]

  @@index([productId])
  @@map("serialized_items")
}

model Supplier {
  id                 String   @id @default(cuid())
  name               String
  phone              String?
  email              String?
  address            String?
  notes              String?
  totalPayable       Decimal  @default(0) @db.Decimal(12, 2)
  paidAmount         Decimal  @default(0) @db.Decimal(12, 2)
  outstandingBalance Decimal  @default(0) @db.Decimal(12, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  transactions   SupplierTransaction[]
  returns        SupplierReturn[]
  stockMovements StockMovement[]

  @@map("suppliers")
}

model SupplierTransaction {
  id         String                  @id @default(cuid())
  supplierId String
  type       SupplierTransactionType
  amount     Decimal                 @db.Decimal(12, 2)
  reference  String?
  notes      String?
  createdAt  DateTime                @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@map("supplier_transactions")
}

model SupplierReturn {
  id               String               @id @default(cuid())
  supplierId       String
  productId        String
  serializedItemId String?
  quantity         Int
  reason           SupplierReturnReason
  notes            String?
  createdAt        DateTime             @default(now())

  supplier       Supplier        @relation(fields: [supplierId], references: [id])
  product        Product         @relation(fields: [productId], references: [id])
  serializedItem SerializedItem? @relation(fields: [serializedItemId], references: [id])

  @@index([supplierId])
  @@index([productId])
  @@map("supplier_returns")
}

model WarrantyPeriod {
  id               String   @id @default(cuid())
  label            String
  durationDays     Int
  isDefault        Boolean  @default(false)
  appliesToSales   Boolean  @default(true)
  appliesToRepairs Boolean  @default(true)
  createdAt        DateTime @default(now())

  products      Product[]      @relation("ProductWarrantyPeriod")
  sales         Sale[]
  saleItems     SaleItem[]
  repairTickets RepairTicket[]

  @@map("warranty_periods")
}

model TradeIn {
  id            String        @id @default(cuid())
  customerId    String?
  customerPhone String?
  customerName  String?
  deviceInfo    String
  imei          String?
  condition     String
  tradeInValue  Decimal       @db.Decimal(12, 2)
  status        TradeInStatus @default(PENDING)
  saleId        String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customer Customer? @relation(fields: [customerId], references: [id])
  sale     Sale?     @relation(fields: [saleId], references: [id])

  @@index([imei])
  @@map("trade_ins")
}

model DefaultAction {
  id                 String            @id @default(cuid())
  triggerDaysOverdue Int
  actionType         DefaultActionType
  description        String
  isActive           Boolean           @default(true)
  createdAt          DateTime          @default(now())

  @@map("default_actions")
}

model StockMovement {
  id              String            @id @default(cuid())
  productId       String
  supplierId      String?
  type            StockMovementType
  quantityDelta   Int
  costPriceAtTime Decimal?          @db.Decimal(12, 2)
  supplierName    String?
  invoiceRef      String?
  employeeId      String
  createdAt       DateTime          @default(now())

  product  Product   @relation(fields: [productId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])
  employee Employee  @relation(fields: [employeeId], references: [id])

  @@index([productId])
  @@index([supplierId])
  @@index([createdAt])
  @@map("stock_movements")
}

model Sale {
  id                String     @id @default(cuid())
  customerId        String?
  employeeId        String
  status            SaleStatus @default(PARKED)
  subtotal          Decimal    @default(0) @db.Decimal(12, 2)
  discount          Decimal    @default(0) @db.Decimal(12, 2)
  discountPercent   Decimal?   @default(0) @db.Decimal(5, 2)
  total             Decimal    @default(0) @db.Decimal(12, 2)
  warrantyPeriodId  String?
  warrantyExpiresAt DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  customer        Customer?        @relation(fields: [customerId], references: [id])
  employee        Employee         @relation(fields: [employeeId], references: [id])
  warrantyPeriod  WarrantyPeriod?  @relation(fields: [warrantyPeriodId], references: [id])
  items           SaleItem[]
  payments        Payment[]
  installmentPlan InstallmentPlan?
  tradeIns        TradeIn[]

  @@index([createdAt])
  @@index([status])
  @@map("sales")
}

model SaleItem {
  id                   String          @id @default(cuid())
  saleId               String
  productId            String
  serializedItemId     String?
  quantity             Int
  unitPrice            Decimal         @db.Decimal(12, 2)
  lineTotal            Decimal         @db.Decimal(12, 2)
  priceType            PriceType       @default(RETAIL)
  warrantyPeriodId     String?
  warrantyDurationDays Int?
  warrantyExpiresAt    DateTime?

  sale               Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product            Product         @relation(fields: [productId], references: [id])
  warrantyPeriod     WarrantyPeriod? @relation(fields: [warrantyPeriodId], references: [id])
  soldSerializedItem SerializedItem?

  @@index([saleId])
  @@map("sale_items")
}


model Payment {
  id        String        @id @default(cuid())
  saleId    String
  amount    Decimal       @db.Decimal(12, 2)
  method    PaymentMethod
  createdAt DateTime      @default(now())

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@map("payments")
}

model InstallmentPlan {
  id                    String            @id @default(cuid())
  saleId                String            @unique
  scheduleJson          Json
  remainingBalance      Decimal           @db.Decimal(12, 2)
  status                InstallmentStatus @default(ACTIVE)
  downPaymentPercent    Decimal?          @db.Decimal(5, 2)
  interestMethod        InterestMethod    @default(PERCENTAGE)
  interestValue         Decimal           @default(0) @db.Decimal(12, 2)
  interestAmount        Decimal           @default(0) @db.Decimal(12, 2)
  totalPayable          Decimal?          @db.Decimal(12, 2)
  lateFeeMethod         LateFeeMethod?
  lateFeeValue          Decimal?          @db.Decimal(12, 2)
  lateFeeAmount         Decimal           @default(0) @db.Decimal(12, 2)
  guarantorName         String?
  guarantorNic          String?
  guarantorPhone        String?
  guarantorAddress      String?
  guarantorPhotoUrl     String?
  guarantorConsentGiven Boolean           @default(false)
  agreementBarcode      String?           @unique
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  sale Sale @relation(fields: [saleId], references: [id])

  @@index([status])
  @@index([agreementBarcode])
  @@map("installment_plans")
}

model RepairTicket {
  id                String            @id @default(cuid())
  ticketNumber      String            @unique
  customerId        String
  deviceInfo        String
  issue             String
  status            RepairStatus      @default(RECEIVED)
  estimate          Decimal?          @db.Decimal(12, 2)
  partsJson         Json?
  photos            String[]          @default([])
  technicianId      String?
  commissionMethod  CommissionMethod?
  commissionValue   Decimal?          @db.Decimal(12, 2)
  commissionAmount  Decimal?          @db.Decimal(12, 2)
  advancePayment    Decimal           @default(0) @db.Decimal(12, 2)
  warrantyPeriodId  String?
  warrantyExpiresAt DateTime?
  isThreeDayWarranty Boolean           @default(false)
  warrantySaleId    String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  customer         Customer          @relation(fields: [customerId], references: [id])
  technician       Employee?         @relation("TechnicianRepairs", fields: [technicianId], references: [id])
  warrantyPeriod   WarrantyPeriod?   @relation(fields: [warrantyPeriodId], references: [id])
  outsourcedRepair OutsourcedRepair?

  @@index([status])
  @@index([createdAt])
  @@index([technicianId])
  @@index([isThreeDayWarranty])
  @@map("repair_tickets")
}

model OutsourcedRepair {
  id                 String                 @id @default(cuid())
  repairTicketId     String                 @unique
  outsourcedTo       String
  sentDate           DateTime               @default(now())
  expectedReturnDate DateTime?
  status             OutsourcedRepairStatus @default(SENT)
  reminder           String?
  notes              String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  repairTicket RepairTicket @relation(fields: [repairTicketId], references: [id], onDelete: Cascade)

  @@map("outsourced_repairs")
}

model AuditLog {
  id         String   @id @default(cuid())
  employeeId String
  action     String
  entity     String
  entityId   String
  beforeJson Json?
  afterJson  Json?
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Outbox {
  id          String       @id @default(cuid())
  type        OutboxType
  payloadJson Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  createdAt   DateTime     @default(now())

  @@index([status])
  @@map("outbox")
}

