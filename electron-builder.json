{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.kzeromobile.pos",
  "productName": "K ZERO MOBILE POS",
  "copyright": "Copyright © 2026 K ZERO MOBILE",
  "directories": {
    "output": "release/1.0.0",
    "buildResources": "build"
  },
  "files": [
    "dist-electron/**/*",
    "apps/web/dist/**/*",
    "apps/server/dist/**/*",
    "apps/server/prisma/**/*",
    "apps/server/package.json",
    "packages/shared/dist/**/*",
    "packages/shared/package.json",
    "node_modules/**/*",
    "package.json"
  ],
  "includeSubNodeModules": true,
  "asar": true,
  "asarUnpack": [
    "apps/server/**/*",
    "packages/shared/**/*",
    "node_modules/**/*",
    "!node_modules/typescript/**/*",
    "!node_modules/vite/**/*",
    "!node_modules/@esbuild/**/*",
    "!node_modules/vitest/**/*",
    "!node_modules/tailwindcss/**/*",
    "!node_modules/rollup/**/*"
  ],
  "cscLink": null,
  "win": {
    "target": [
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "sign": "electron/sign.js",
    "verifyUpdateCodeSignature": false
  },
  "publish": {
    "provider": "github"
  }
}
